# SuchConfig Tauri Environment Configuration

# Path to the suchconfig-desktop Phoenix application
# Default: ./phoenix-app
# Custom: /absolute/path/to/suchconfig-desktop
SUCHCONFIG_DESKTOP_PATH=./phoenix-app

# Phoenix LiveView server port
# Default: 4000
PHOENIX_PORT=4000

# Database Configuration
# Desktop app uses SQLite for local storage (no configuration needed)
# The app connects to suchconfig-api for sync operations

# SuchConfig API Configuration (optional)
# API_BASE_URL=http://localhost:4000
# API_URL=http://localhost:4000/api/v1

# Development mode settings
# Set to 'true' for development, 'false' for production
DEV_MODE=true

# Logging level
# Options: debug, info, warn, error
LOG_LEVEL=info
